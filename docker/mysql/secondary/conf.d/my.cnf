[mysqld]
server-id=2
log_bin=mysql-bin
relay_log=relay-bin
binlog_format=ROW
gtid_mode=ON
enforce_gtid_consistency=ON
read_only=ON
super_read_only=ON
default_authentication_plugin=mysql_native_password

# Aqui va la configuracion real del nodo secondary.
# Tu companero de BD puede completar CHANGE REPLICATION SOURCE TO y arranque de replica.
